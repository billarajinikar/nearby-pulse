{% comment %} extensions/nearby-pulse-extension/blocks/social_proof.liquid {% endcomment %}

<style>
  .nearby-pulse-widget {
    display: none;
    margin: 14px 0;
    padding: 14px 16px;
    border: 1px solid rgba(34, 197, 94, 0.25);
    border-radius: 12px;
    background: linear-gradient(135deg, #f0fdf4, #ffffff);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    font-family: inherit;
    animation: nearbyPulseFadeIn 0.35s ease-out;
  }

  .nearby-pulse-inner {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .nearby-pulse-icon {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 999px;
    background: #dcfce7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
  }

  .nearby-pulse-content {
    flex: 1;
  }



  .nearby-pulse-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    color: #1f2937;
  }



  @keyframes nearbyPulseFadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 749px) {
    .nearby-pulse-widget {
      padding: 12px 14px;
      border-radius: 10px;
    }

    .nearby-pulse-text {
      font-size: 13px;
    }
  }
</style>

<div id="nearby-pulse-widget" class="nearby-pulse-widget">
  <div class="nearby-pulse-inner">
    <div class="nearby-pulse-icon">📍</div>

    <div class="nearby-pulse-content">
      <p id="pulse-text" class="nearby-pulse-text"></p> Billa
    </div>
  </div>
</div>

<script>
(function () {
  const widget = document.getElementById("nearby-pulse-widget");
  const textElement = document.getElementById("pulse-text");

  if (!widget || !textElement) {
    console.error("[NearbyPulse] Widget HTML elements were not found.");
    return;
  }

  const productId = "{{ product.id }}";
  const productTitle = "{{ product.title | escape }}";

  if (!productId) {
    console.error("[NearbyPulse] Product ID is missing.");
    return;
  }

  const storageKey = `nearby_pulse_${productId}`;
  const now = Date.now();

  const query = new URLSearchParams({
    product_id: productId,
    product_title: productTitle,
    cache_buster: String(now)
  });

  const endpoint = `/apps/nearby-pulse?${query.toString()}`;

  console.log("[NearbyPulse] Starting widget");
  console.log("[NearbyPulse] Product ID:", productId);
  console.log("[NearbyPulse] Request URL:", endpoint);

  fetch(endpoint, {
    method: "GET",
    headers: {
      Accept: "application/json"
    },
    credentials: "same-origin",
    cache: "no-store"
  })
    .then(async function (response) {
      const responseText = await response.text();

      console.log("[NearbyPulse] HTTP status:", response.status);
      console.log("[NearbyPulse] Raw API response:", responseText);

      if (!response.ok) {
        throw new Error(
          `NearbyPulse request failed with status ${response.status}: ${responseText}`
        );
      }

      try {
        return JSON.parse(responseText);
      } catch (error) {
        throw new Error(
          `NearbyPulse returned invalid JSON: ${responseText}`
        );
      }
    })
    .then(function (data) {
      console.log("[NearbyPulse] Parsed response:", data);

      if (!data.shouldShow) {
        console.warn(
          "[NearbyPulse] API returned shouldShow=false.",
          data.debugReason || data
        );
        return;
      }

      if (!data.message) {
        console.warn(
          "[NearbyPulse] API returned no message.",
          data
        );
        return;
      }

      const oneHour = 60 * 60 * 1000;

      const cooldownMinutes = Number(
        data.cooldownMinutes ?? 0
      );

      const cooldown = cooldownMinutes * 60 * 1000;

      const maxPerHour = Number(
        data.maxPerProductPerHour ?? 20
      );

      let history = [];

      try {
        history = JSON.parse(
          localStorage.getItem(storageKey) || "[]"
        );

        if (!Array.isArray(history)) {
          history = [];
        }
      } catch (error) {
        console.warn(
          "[NearbyPulse] Invalid localStorage history. Resetting it.",
          error
        );

        history = [];
      }

      history = history.filter(function (item) {
        return (
          item &&
          Number.isFinite(Number(item.time)) &&
          now - Number(item.time) < oneHour
        );
      });

      const lastShown =
        history.length > 0
          ? Number(history[history.length - 1].time)
          : 0;

      console.log("[NearbyPulse] Display limits:", {
        historyCount: history.length,
        maxPerHour,
        cooldownMinutes,
        lastShown,
        millisecondsSinceLastShown: now - lastShown
      });

      if (history.length >= maxPerHour) {
        console.warn(
          "[NearbyPulse] Widget blocked by hourly limit."
        );
        return;
      }

      if (lastShown && now - lastShown < cooldown) {
        console.warn(
          "[NearbyPulse] Widget blocked by cooldown."
        );
        return;
      }

      textElement.textContent = data.message;
      widget.style.display = "block";

      console.log(
        "[NearbyPulse] Widget displayed:",
        data.message
      );

      history.push({
        time: now,
        messageType: data.messageType || null
      });

      localStorage.setItem(
        storageKey,
        JSON.stringify(history)
      );

      const trackingKey =
        `nearby_pulse_tracked_${productId}`;

      const trackingWindow =
        30 * 60 * 1000;

      const lastTracked = Number(
        localStorage.getItem(trackingKey) || 0
      );

      const canTrack =
        now - lastTracked > trackingWindow;

      function sendEvent(eventType) {
        if (!data.tracking) {
          console.warn(
            `[NearbyPulse] Tracking data missing for ${eventType}.`
          );
          return;
        }

        fetch("/apps/nearby-pulse", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json"
          },
          credentials: "same-origin",
          body: JSON.stringify({
            ...data.tracking,
            event_type: eventType
          })
        })
          .then(async function (response) {
            const responseText = await response.text();

            console.log(
              `[NearbyPulse] ${eventType} tracking response:`,
              response.status,
              responseText
            );
          })
          .catch(function (error) {
            console.error(
              `[NearbyPulse] ${eventType} tracking failed:`,
              error
            );
          });
      }

      if (canTrack) {
        sendEvent("widget_shown");

        localStorage.setItem(
          trackingKey,
          String(now)
        );
      }

      widget.addEventListener(
        "click",
        function onWidgetClick() {
          sendEvent("widget_clicked");
        },
        {
          once: true
        }
      );

      const displaySeconds = Math.max(
        3,
        Number(data.displaySeconds || 10)
      );

      window.setTimeout(function () {
        widget.style.display = "none";

        console.log(
          "[NearbyPulse] Widget hidden after",
          displaySeconds,
          "seconds"
        );
      }, displaySeconds * 1000);
    })
    .catch(function (error) {
      console.error("[NearbyPulse] Widget error:", error);
    });
})();
</script>
{% schema %}
{
  "name": "NearbyPulse Widget",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Widget Title",
      "default": "Nearby Activity"
    }
  ]
}
{% endschema %}
